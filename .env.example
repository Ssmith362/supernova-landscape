# ---------------------------------------------------------------------------
# Copy to .env.local for local development, and set the same keys in
# Hostinger's environment variables panel for production.
#
# .env.local and .env.production are gitignored. NEVER commit real keys.
# ---------------------------------------------------------------------------

# REQUIRED. The canonical production origin. Every canonical URL, the sitemap
# and every Open Graph URL are built from this.
#
#   Production : https://www.supernovalandscape.com
#   Staging    : https://whatever.hostingersite.com
#   Local      : http://localhost:3000
#
# Anything other than the production value makes robots.txt disallow the whole
# site, so a staging build can never be indexed or become the canonical.
NEXT_PUBLIC_SITE_URL=https://www.supernovalandscape.com


# ---------------------------------------------------------------------------
# Quote form delivery — see src/lib/quote/delivery.ts
#
# Until all four are set, the form validates and then tells the visitor
# honestly that it is not connected, and points them at the phone number.
# It never claims a request was sent when it was not.
# ---------------------------------------------------------------------------

# Currently implemented: resend
QUOTE_DELIVERY_PROVIDER=
QUOTE_DELIVERY_API_KEY=

# Where quote requests are emailed.
QUOTE_NOTIFY_EMAIL=Damien@supernovalandscape.com

# Must be a sender address verified with the provider. Do NOT use a free
# mailbox here — SPF/DKIM alignment is what keeps requests out of spam.
QUOTE_FROM_EMAIL=website@supernovalandscape.com


# ---------------------------------------------------------------------------
# Analytics — all optional. Nothing loads and no third-party JavaScript ships
# unless these are set. No invented IDs exist anywhere in the repo.
# ---------------------------------------------------------------------------

# GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Ads conversion ID, e.g. AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Search Console HTML-tag verification: the `content` value only, not the tag.
NEXT_PUBLIC_GSC_VERIFICATION=
